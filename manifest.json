{
    "manifest_version":3,
    "name":"adSwap",
    "version":"0.1.0",
    "action":{
        "default_popup":"popup.html"
    },
    "web_accessible_resources": [
    {
        "resources": ["audio/test-tone.wav"],
        "matches": ["https://open.spotify.com/*"]
    }],
    "permissions": ["offscreen"],
    "background": {
        "service_worker": "background.js"
    }
}